{
  "name": "WhatsApp Avatar Checker API",
  "brand": "WA Lookup",
  "repository": "walookup/whatsapp-avatar-checker-api",
  "description": "Synchronous single and batch checks for WhatsApp Avatar.",
  "official_site": "https://walookup.com",
  "landing_page": "https://walookup.com/products/ws_avatar",
  "canonical_docs": "https://walookup.com/api-docs",
  "base_url": "https://walookup.com",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "mode": "sync-batch",
  "endpoints": {
    "single": {
      "method": "POST",
      "path": "/api/v1/check"
    },
    "batch": {
      "method": "POST",
      "path": "/api/v1/batch-check",
      "min_items": 1,
      "max_items": 100
    },
    "balance": {
      "method": "GET",
      "path": "/api/v1/balance"
    }
  },
  "limits": {
    "numbers_per_utc_minute": 200,
    "concurrent_checks": 5,
    "concurrent_batches": 1
  },
  "products": [
    {
      "type": "ws_avatar",
      "name": "WhatsApp Avatar Verification",
      "inputKind": "phone",
      "min_inputs": 1,
      "max_inputs": 100,
      "docs_url": "https://walookup.com/api-docs",
      "fields": [
        "service_type",
        "identifier",
        "registered",
        "avatar",
        "avatar_url"
      ]
    }
  ],
  "pricing_url": "https://walookup.com/pricing",
  "maintainer": "WA Lookup",
  "license": "MIT",
  "last_reviewed": "2026-08-18"
}
